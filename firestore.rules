rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Contenu public : lecture ouverte, écriture réservée aux admins connectés.
    match /services/{doc}   { allow read: if true; allow write: if request.auth != null; }
    match /tarifs/{doc}     { allow read: if true; allow write: if request.auth != null; }
    match /promotions/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /horaires/{doc}   { allow read: if true; allow write: if request.auth != null; }
    match /semaines/{doc}   { allow read: if true; allow write: if request.auth != null; }
    // Créneaux publiés par date (« Mes disponibilités ») — doc id `${orgId}_${date}`
    match /creneaux/{doc}   { allow read: if true; allow write: if request.auth != null; }
    match /galerie/{doc}    { allow read: if true; allow write: if request.auth != null; }
    match /settings/{doc}   { allow read: if true; allow write: if request.auth != null; }

    // Occupation : créneaux bloqués, sans donnée personnelle. Lisibles par
    // tous (calcul des disponibilités), créés par les visiteurs, supprimés
    // uniquement par l'admin (libération d'un créneau).
    match /occupation/{doc} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Réservations : un visiteur peut en créer une, mais seule l'admin
    // peut les lire, modifier ou supprimer.
    match /reservations/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
